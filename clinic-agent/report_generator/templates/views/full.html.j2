{% extends "base.html.j2" %}

{% block content %}
<section class="section">
  <h2 class="section-title">报告概述</h2>
  <p class="summary-lead">{{ data.summary }}</p>
</section>

<section class="section">
  <h2 class="section-title">关键指标</h2>
  <div class="metrics-grid">
    {% for m in data.key_metrics %}
    <div class="metric-card">
      <div class="metric-label">{{ m.label }}</div>
      <div class="metric-value">{{ m.value }}{% if m.unit %}<span class="metric-unit">{{ m.unit }}</span>{% endif %}</div>
      <div class="metric-trend trend-{{ m.trend }}">{{ {'up': '↑ 上升', 'down': '↓ 下降', 'flat': '→ 平稳'}.get(m.trend, '') }}</div>
    </div>
    {% endfor %}
  </div>
</section>

{% for rtype, records in grouped.items() %}
<section class="section">
  <h2 class="section-title">{{ record_type_labels[rtype] }}（{{ records|length }} 条）</h2>
  <div class="record-grid">
    {% for r in records %}
    <article class="record-card">
      {% if r.asset_url %}
      <img class="record-media" src="{{ r.asset_url }}" alt="{{ r.title }}">
      {% else %}
      <div class="placeholder type-{{ r.record_type }}">{{ record_type_labels[rtype] }}</div>
      {% endif %}
      <div class="record-body">
        <span class="record-type-badge type-{{ r.record_type }}">{{ record_type_labels[rtype] }}</span>
        <h3>{{ r.title }}</h3>
        <time>{{ r.recorded_at }}</time>
        <p>{{ r.summary }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
{% endfor %}

<section class="section">
  <h2 class="section-title">全量时间轴</h2>
  <div class="timeline">
    {% for r in timeline %}
    <div class="timeline-item">
      <div class="timeline-date">{{ r.recorded_at }}</div>
      <div class="timeline-body">
        <span class="record-type-badge type-{{ r.record_type }}">{{ record_type_labels[r.record_type] }}</span>
        <strong>{{ r.title }}</strong>
        <p>{{ r.summary }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
