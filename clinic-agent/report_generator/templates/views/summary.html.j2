{% extends "base.html.j2" %}

{% block content %}
<section class="section">
  <h2 class="section-title">摘要</h2>
  <p class="summary-lead">{{ data.summary }}</p>
</section>

<section class="section">
  <h2 class="section-title">关键指标</h2>
  <div class="metrics-grid">
    {% for m in data.key_metrics %}
    <div class="metric-card">
      <div class="metric-label">{{ m.label }}</div>
      <div class="metric-value">{{ m.value }}{% if m.unit %}<span class="metric-unit">{{ m.unit }}</span>{% endif %}</div>
      <div class="metric-trend trend-{{ m.trend }}">{{ {'up': '↑ 上升', 'down': '↓ 下降', 'flat': '→ 平稳'}.get(m.trend, '') }}</div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="section">
  <h2 class="section-title">最近动态</h2>
  <div class="timeline">
    {% for r in recent_records %}
    <div class="timeline-item">
      <div class="timeline-date">{{ r.recorded_at }}</div>
      <div class="timeline-body">
        <span class="record-type-badge type-{{ r.record_type }}">{{ record_type_labels[r.record_type] }}</span>
        <strong>{{ r.title }}</strong>
        <p>{{ r.summary }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
